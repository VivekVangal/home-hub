rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // Each signed-in user's own profile: { uid, email, familyId }.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Maps an invite code to nothing but a familyId — deliberately minimal.
    // "get" (a direct read by exact document id) is allowed to any signed-in
    // user, since you have to already know the 6-character code to ask for
    // it — same trust model as an invite link. "list" (querying/enumerating
    // the whole collection) is blocked, so there's no way to browse or guess
    // your way through every code that exists. This indirection is what lets
    // families/{familyId} below stay members-only: joinFamily() resolves a
    // code through here instead of querying the families collection
    // directly, which would've required exposing family names/owners to any
    // signed-in user, including ones from unrelated families.
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /families/{familyId} {
      // Members-only. Nobody outside a family — not even another signed-in
      // Home Hub user — can read its name, owner, or invite code unless
      // they're already a member of it.
      allow read: if isMember(familyId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isMember(familyId);
      allow delete: if false;

      match /members/{memberId} {
        allow read: if isMember(familyId);
        // Creating your own member doc is how "joining" works; you can only
        // ever create/update the doc whose id is your own uid.
        allow create, update: if isSignedIn() && request.auth.uid == memberId;
        // Removing a member (Settings page "remove") requires being a
        // member of the same family yourself.
        allow delete: if isMember(familyId);
      }

      match /events/{eventId} {
        allow read, write: if isMember(familyId);
      }

      match /tasks/{taskId} {
        allow read, write: if isMember(familyId);
      }

      match /groceries/{groceryId} {
        allow read, write: if isMember(familyId);
      }

      // Training profiles hold personal goals, target times, and injury
      // notes — deliberately stricter than everything else in this family's
      // data. Every other collection here is member-wide readable (the
      // whole point of a shared household calendar); this one is
      // self-only, even from other members of the same family.
      match /trainingProfiles/{uid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }
  }
}
